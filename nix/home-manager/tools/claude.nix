# Claude Code itself is installed by its native installer (self-updating).
{
  lib,
  pkgs,
  link,
  ...
}:
let
  # Permissions merged into ~/.claude/settings.json.
  # The file is not generated by Nix because Claude Code writes to it.
  deny = [
    "Read(~/.ssh/**)"
    "Read(**/.env)"
    "Read(**/.env.*)"
    "Bash(sudo:*)"
    "Bash(pip:*)"
    "Bash(pip3:*)"
    "Bash(poetry:*)"
  ];
  skills = builtins.attrNames (
    lib.filterAttrs (_: type: type == "directory") (builtins.readDir ../../../config/claude/skills)
  );
in
{
  home.file.".claude/scripts".source = link "claude/scripts";

  my.skills = lib.genAttrs skills (name: link "claude/skills/${name}");

  home.activation.claudePermissions = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    if [[ ! -v DRY_RUN ]]; then
      settings="$HOME/.claude/settings.json"
      mkdir -p "$HOME/.claude"
      [ -f "$settings" ] || echo '{}' > "$settings"
      tmp=$(mktemp)
      ${pkgs.jq}/bin/jq --argjson d ${lib.escapeShellArg (builtins.toJSON deny)} \
        '.permissions.deny = (((.permissions.deny // []) + $d) | unique)' \
        "$settings" > "$tmp"
      mv "$tmp" "$settings"
    fi
  '';

  my.human.aliases.cl = "claude";
}
