# commands
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'

# git
alias g='git'
alias ga="git add"
alias gap="git add -p"
alias gc="git commit"
alias gp="git push"
alias gpl="git pull"
alias gl="git log --graph --color=always --date=iso --pretty=format:'%C(yellow)%h %C(green)%cd %C(reset)%s %C(red)%d %C(cyan)[%an]'"
alias gs="git status"
alias gd="git diff"
alias gb="git branch"
alias gswc="git switch -c"
alias gswt="fzf-switch-worktree"
alias cs="agent"
alias cl="claude"

# Aliases for commands which may not be installed.
[ $(command -v docker-compose) ] && alias dc="docker-compose"
[ $(command -v nvim) ] && alias e='nvim'
[ $(command -v tmux) ] && alias t='tmux'
[ $(command -v procs) ] && alias ps="procs"
[ $(command -v terraform) ] && alias tf="terraform"
[ $(command -v powershell.exe) ] && alias open="powershell.exe /c start"
whence -p rg >/dev/null && alias rg="rg --hidden -g '!.git'"
whence -p gdate >/dev/null && alias date="gdate"

if [ $(command -v cargo) ]; then
    alias c="cargo"
    alias cb="cargo build"
    alias cf="cargo fmt"
    alias ct="cargo test"
    alias cr="cargo run"
    alias cli="cargo clippy --all-features"
    alias co="cargo outdated"
fi

if [ $(command -v eza) ]; then
    alias l="eza"
    alias ls="eza"
    alias la="eza -a"
    alias ll="eza -lab --time-style=long-iso"
    alias tree='eza -al --tree --git-ignore -I ".git"'
else
    alias l="ls"
    alias la="ls -a"
    alias ll="ls -al"
fi

# Show paths splitted with newline.
alias path="printf '%b\n' '${PATH//:/\\n}'"
