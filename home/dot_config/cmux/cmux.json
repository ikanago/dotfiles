{
    "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
    "schemaVersion": 1,
    "browser": {
        "openTerminalLinksInCmuxBrowser": false
    },
    "shortcuts": {
        "bindings": {
            "focusLeft": "opt+h",
            "focusDown": "opt+j",
            "focusUp": "opt+k",
            "focusRight": "opt+l",
            "prevSurface": "ctrl+opt+,",
            "nextSurface": "ctrl+opt+.",
            "nextSidebarTab": "opt+,",
            "prevSidebarTab": "opt+.",
            "splitRight": "cmd+d",
            "splitDown": "cmd+shift+d",
            "reloadConfiguration": ["ctrl+q", "r"]
        }
    }
}
